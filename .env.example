# 问津 · WenJin - 环境变量配置示例
# 复制此文件为 .env 并在本地填入相应值（.env 已被 .gitignore 忽略，不会提交到版本库）

# ==============================================================================
# AI 推理配置 (DeepSeek)
# ==============================================================================
# DeepSeek API Key (必须，从 https://platform.deepseek.com/ 获取)
DEEPSEEK_API_KEY=

# DeepSeek API 请求地址（可选，默认官方地址）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ==============================================================================
# 服务与数据库配置
# ==============================================================================
# SQLite 数据库文件路径（可选，默认项目根目录 gaokao2025.sqlite）
# GAOKAO_DB=/path/to/gaokao2025.sqlite

# 默认服务端口（可选，默认 5080）
# GAOKAO_PORT=5080

# 招生计划年份与录取分数年份（可选，默认当前年与上一年）
# GAOKAO_PLAN_YEAR=2026
# GAOKAO_SCORE_YEAR=2025

# 简易访问鉴权 Token（可选，设置后需携带 X-API-Token 请求头）
# GAOKAO_API_TOKEN=

# 请求限流配置（每 IP 每分钟最大请求数，0 为关闭）
# GAOKAO_RATE_LIMIT=60
